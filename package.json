{
  "name": "deezer-music-player",
  "version": "1.0.0",
  "private": true,
  "description": "Deezer music browser served with Node.js and Express",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "npm run start -w backend",
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "server": "npm run start -w backend",
    "dev:server": "npm run dev -w backend"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
